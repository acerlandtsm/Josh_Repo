package myFirstProject;

import java.awt.BorderLayout;
import java.awt.FlowLayout;
import java.awt.Font;
import java.awt.GridLayout;
import java.awt.event.ActionEvent;
import java.awt.event.ActionListener;

import javax.swing.JButton;
import javax.swing.JFrame;
import javax.swing.JLabel;
import javax.swing.JPanel;
import javax.swing.JPasswordField;
import javax.swing.JTextField;
import javax.swing.SwingConstants;
import javax.swing.SwingUtilities;

public class MainFrame extends JFrame {

	private JLabel welcomeLbl;
	private JLabel welcomeLbl2;
	private JLabel usernameLbl;
	private JLabel passwordLbl;
	
	private JButton loginBtn;
	private JButton signupBtn;
	private JButton loginBtn2;
	
	private JTextField enterUser;
	private JPasswordField enterPass;
	
	public MainFrame() {
		//FRAME
		setTitle("Onboarding Page");
		setSize(300,200);
		setDefaultCloseOperation(JFrame.EXIT_ON_CLOSE);
		setLocationRelativeTo(null);
		
		//PANELS
		JPanel northPanel = new JPanel();
		JPanel centerPanel = new JPanel();
		JPanel centerInnerPanel = new JPanel();
		JPanel loginPanel = new JPanel();
		
		
		//LAYOUT
		setLayout(new BorderLayout());
		add(northPanel, BorderLayout.NORTH);
		add(centerPanel, BorderLayout.CENTER);
		
		//NORTH PANEL
		welcomeLbl = new JLabel("Welcome back");
		welcomeLbl.setFont(new Font("Arial", Font.PLAIN, 25));
		northPanel.add(welcomeLbl, BorderLayout.CENTER);
		
		//CENTER PANEL
		welcomeLbl2 = new JLabel("login now or sign up!", SwingConstants.CENTER);
		welcomeLbl2.setFont(new Font("Arial", Font.PLAIN, 16));
		centerPanel.setLayout(new BorderLayout());
		centerPanel.add(welcomeLbl2, BorderLayout.CENTER);
		centerPanel.add(centerInnerPanel, BorderLayout.SOUTH);

		//CENTER INNER PANEL
		centerInnerPanel.setLayout(new FlowLayout(FlowLayout.CENTER, 20, 10));
		loginBtn = new JButton("LOG IN");
		signupBtn = new JButton("SIGN UP");
		centerInnerPanel.add(loginBtn);
		centerInnerPanel.add(signupBtn);
		
		//LOGIN PANEL
		loginPanel.setLayout(new GridLayout(0,2));
		usernameLbl = new JLabel("username: ");
		loginPanel.add(usernameLbl);
		
		enterUser = new JTextField(20);
		loginPanel.add(enterUser);
		passwordLbl = new JLabel("password: ");
//		loginPanel.add(passwordLbl);
//		loginPanel.add(enterPass);
		loginBtn2 = new JButton("LOG IN");
		loginPanel.setVisible(false);
		loginPanel.add(loginBtn2, BorderLayout.SOUTH);
		
		
		//LOGIN BUTTON BEHAVIOR
		loginBtn.addActionListener(new ActionListener() {
			@Override
			public void actionPerformed(ActionEvent e) {
				add(loginPanel, BorderLayout.CENTER);
				loginPanel.setVisible(true);
				northPanel.setVisible(false);
				centerPanel.setVisible(false);
				centerInnerPanel.setVisible(false);
			}
			
		});
		
		signupBtn.addActionListener(new ActionListener() {
			@Override
			public void actionPerformed(ActionEvent e) {
				
			}
			
		});
		
	}
	public static void main(String[]  args) {
		SwingUtilities.invokeLater(() -> {
			new MainFrame().setVisible(true);
		});
	}
} 



	
