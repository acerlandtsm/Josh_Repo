package josh;

import java.sql.Connection;
import java.sql.PreparedStatement;
import java.sql.ResultSet;
import java.sql.SQLException;

import database.DBConnection;

public class userSession {
	
	private static String currentUsername;
	private static String currentRole;
	
	//LOGIN LOGIC
	public static Boolean login(String user, char[] inputPass) {
		String sql = "SELECT password, role FROM tbl_users WHERE username = ?";
		try (Connection conn = DBConnection.getConnection();
			PreparedStatement stmt = conn.prepareStatement(sql)) {
			
			stmt.setString(1, user);
			
			try (ResultSet rs = stmt.executeQuery()) {
				if(rs.next()) {
					String storedPassword = rs.getString("password");
					String storedRole = rs.getString("role");
					String inputPassString = new String(inputPass);
					
					if (inputPassString.equals(storedPassword)) {
						currentUsername = user;
						currentRole = storedRole;
						return true;
					}
				} 
			}
		}catch (SQLException ex) {
			ex.printStackTrace();
		}
		return false;
	} 
	
	public static Boolean accountChecker(String user, char[] pass, char[] confirmPass) {
		String passString = new String(pass);
		String confirmPassString = new String(confirmPass);
		
		if (!user.isEmpty() || !passString.isEmpty() || !confirmPassString.isEmpty()) {
			if (passString.equals(confirmPassString)) {
				return true;
			} else {
				return false;
			}
		} else {
			return false;
		}
	}
	
	public static Boolean signup(String user, String inputPass) {
		String sql = "INSERT INTO tbl_users (username, password) VALUES (?, ?)";
		try (Connection conn = DBConnection.getConnection();
				PreparedStatement stmt = conn.prepareStatement(sql)) {
			
			stmt.setString(1, user);
			stmt.setString(2, inputPass);
			
			int rowsInserted = stmt.executeUpdate();
			return rowsInserted > 0;
		}catch (SQLException ex) {
			if (ex.getSQLState().equals("23505")) {
				javax.swing.JOptionPane.showMessageDialog(null, "Username is already taken.");
	        } else {
	             ex.printStackTrace();
	        }
		return false;
		}
	}
	
	//GETTERS
	public static String getUsername() { return currentUsername; }
	public static String getRole() { return currentRole; }
	
	//LOGOUT LOGIC
	public static void logout() {
		currentUsername = null;
		currentRole = null;
	}
}